<script>
    function switchAuthMode(mode) {
        var loginBtn = document.getElementById('tabLoginBtn');
        var regBtn = document.getElementById('tabRegisterBtn');
        var nameField = document.getElementById('nameFieldContainer');
        var submitBtn = document.getElementById('submitBtn');

        if (mode === 'login') {
            loginBtn.style.background = '#2e8b6b'; loginBtn.style.color = 'white';
            regBtn.style.background = 'transparent'; regBtn.style.color = '#5c6b63';
            nameField.style.display = 'none'; submitBtn.innerText = 'Увійти в кабінет';
        } else {
            regBtn.style.background = '#2e8b6b'; regBtn.style.color = 'white';
            loginBtn.style.background = 'transparent'; loginBtn.style.color = '#5c6b63';
            nameField.style.display = 'block'; submitBtn.innerText = 'Створити акаунт';
        }
    }

    function handleLoginSuccess() {
        var nameInput = document.getElementById('userName').value;
        if(nameInput) { document.getElementById('displayUserName').innerText = nameInput; }
        document.getElementById('authScreen').style.display = 'none';
        document.getElementById('dashScreen').style.display = 'block';
    }

    function handleFormSubmit(event) {
        event.preventDefault();
        handleLoginSuccess();
    }

    function handleLogout() {
        document.getElementById('dashScreen').style.display = 'none';
        document.getElementById('authScreen').style.display = 'block';
    }

    // УПРАВЛІННЯ ВКЛАДКАМИ БІЧНОГО МЕНЮ
    function switchTab(tabName) {
        var menuItems = ['cabinet', 'dictionary', 'schedule', 'analytics', 'chat'];
        for (var i = 0; i < menuItems.length; i++) {
            var item = document.getElementById('menu-' + menuItems[i]);
            if (menuItems[i] === tabName) {
                item.style.background = '#e1f5ed';
                item.style.color = '#2e8b6b';
                item.style.fontWeight = '600';
                item.style.borderLeft = '4px solid #2e8b6b';
            } else {
                item.style.background = 'transparent';
                item.style.color = '#5c6b63';
                item.style.fontWeight = '500';
                item.style.borderLeft = '4px solid transparent';
            }
        }

        // Ховаємо всі розділи
        document.getElementById('courseLessonsView').style.display = 'none';
        document.getElementById('lessonDetailView').style.display = 'none';
        document.getElementById('coursesMainView').style.display = 'none';
        document.getElementById('dictionaryListView').style.display = 'none';
        document.getElementById('dictionaryDetailView').style.display = 'none';
        document.getElementById('scheduleView').style.display = 'none';
        document.getElementById('analyticsView').style.display = 'none';
        document.getElementById('chatView').style.display = 'none';
        document.getElementById('genericView').style.display = 'none';

        if(tabName === 'cabinet') {
            document.getElementById('coursesMainView').style.display = 'block';
            resetCoursesMainView();
        } else if(tabName === 'dictionary') {
            openDictionaryList();
        } else if(tabName === 'schedule') {
            document.getElementById('scheduleView').style.display = 'block';
        } else if(tabName === 'analytics') {
            document.getElementById('analyticsView').style.display = 'block';
        } else if(tabName === 'chat') {
            document.getElementById('chatView').style.display = 'block';
        } else {
            var genericView = document.getElementById('genericView');
            genericView.style.display = 'block';
            genericView.innerHTML = `
                <h2 style="color: #1a4d3b; margin-top: 0; margin-bottom: 15px; font-size: 22px;">${getTabTitle(tabName)}</h2>
                <p style="color: #666; font-size: 14px;">Цей розділ наповнюється навчальними матеріалами.</p>`;
        }
    }

    function getTabTitle(t) {
        if(t === 'chat') return '💬 Спільний чат та обговорення';
        return '';
    }

    function resetCoursesMainView() {
        document.getElementById('coursesMainView').innerHTML = `
            <h2 style="color: #1a4d3b; margin-top: 0; margin-bottom: 20px; font-size: 22px;">Мої матеріали та курси</h2>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px;">
                <div style="background: #ffffff; border-radius: 16px; border: 1px solid #d4e8e0; overflow: hidden; box-shadow: 0 4px 12px rgba(46,105,85,0.04); display: flex; flex-direction: column;">
                    <div style="background: #fdfae5; padding: 25px; text-align: center; font-size: 32px; font-weight: 800; color: #b78103;">A1</div>
                    <div style="padding: 20px; display: flex; flex-direction: column; flex: 1;">
                        <h3 style="margin: 0 0 8px 0; color: #1a4d3b; font-size: 16px;">General English A1</h3>
                        <p style="color: #666; font-size: 13px; margin: 0 0 20px 0;">Уроків: 17</p>
                        <button type="button" onclick="openCourse('A1')" style="margin-top: auto; width: 100%; padding: 10px; background: #2e8b6b; color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer;">Відкрити</button>
                    </div>
                </div>
            </div>`;
    }

    function openCourse(level) {
        document.getElementById('coursesMainView').style.display = 'none';
        document.getElementById('lessonDetailView').style.display = 'none';
        var lessonsView = document.getElementById('courseLessonsView');
        lessonsView.style.display = 'block';

        lessonsView.innerHTML = `
            <button type="button" onclick="backToCourses()" style="background: none; border: none; color: #2e8b6b; font-weight: 600; cursor: pointer; margin-bottom: 15px; display: flex; align-items: center; gap: 5px;">← Назад до курсів</button>
            <h2 style="color: #1a4d3b; margin-top: 0; margin-bottom: 20px; font-size: 22px;">Курс General English ${level}</h2>
            
            <div style="display: flex; flex-direction: column; gap: 12px;">
                <div style="background: #ffffff; padding: 18px 20px; border-radius: 12px; border: 1px solid #d4e8e0; display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <div style="font-weight: 600; color: #1a4d3b; font-size: 15px;">Урок 1: Знайомство та алфавіт</div>
                        <div style="color: #2e8b6b; font-size: 12px; margin-top: 4px;">✔ Доступно</div>
                    </div>
                    <button type="button" onclick="openLesson('lesson1')" style="padding: 8px 16px; background: #2e8b6b; color: white; border: none; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer;">Вчити урок</button>
                </div>

                <div style="background: #f8fbfa; padding: 18px 20px; border-radius: 12px; border: 1px solid #eaeaea; display: flex; justify-content: space-between; align-items: center; opacity: 0.7;">
                    <div>
                        <div style="font-weight: 600; color: #5c6b63; font-size: 15px;">Урок 2: Базові фрази та числа</div>
